{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "image": "sdk-55"
      }
    },
    "development-device": {
      "extends": "development",
      "ios": {
        "simulator": false,
        "image": "sdk-55"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "image": "sdk-55"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "sdk-55"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
